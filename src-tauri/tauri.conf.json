{
  "$schema": "https://raw.githubusercontent.com/nicedoc/docs-tauri-app/refs/heads/main/docs/.vitepress/public/reference/config.schema.json",
  "productName": "DrawDB",
  "version": "1.0.0",
  "identifier": "com.drawdb.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "DrawDB - Database Diagram Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "fs": {
      "scope": {
        "allow": [
          { "path": "$APPDATA/**", "permission": "readwrite" },
          { "path": "$DOCUMENT/**", "permission": "readwrite" },
          { "path": "$HOME/**", "permission": "readwrite" },
          { "path": "$DESKTOP/**", "permission": "readwrite" }
        ]
      }
    },
    "dialog": {
      "all": true
    },
    "shell": {
      "open": true
    }
  }
}